# The template editor is available in Admin, but existing exports stay unchanged.
VITE_DOCUMENT_TEMPLATE_CENTER_ON=1
# Safe default: the active repair-contract generator remains unchanged.
VITE_DOCUMENT_TEMPLATES_REPAIR_ON=0

# Server-only GitHub fine-grained token: repository Actions read/write.
# Add only in Vercel Production; never prefix it with VITE_ and never commit its value.
GITHUB_PARSER_TOKEN=
