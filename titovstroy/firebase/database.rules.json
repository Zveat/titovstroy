// ПРАВИЛА ДОСТУПА К БАЗЕ. Публикуются в консоли Firebase → Realtime Database → Правила.
// Здесь лежит копия под версией, чтобы было видно, что именно опубликовано и почему.
//
// ФОРМАТ: комментарии — ТОЛЬКО строками через //. Ключи вида "//": "текст" консоль не
// принимает («Expected '{'»): значением дочернего ключа обязан быть объект с правилами.
//
// ПРАВА БЕРЁМ ИЗ МАТРИЦЫ «ПРАВА РОЛЕЙ», А НЕ ИЗ НАЗВАНИЯ РОЛИ. Матрица лежит в базе одной
// строкой JSON — правила строку разобрать не умеют. Поэтому её читает сервер входа
// (api/login.js) и кладёт в токен флаги: fin — можно писать деньги, pay — зарплаты,
// cat — каталог и прайс, usr — пользователей и саму матрицу, finR/payR — читать деньги и
// зарплаты. Правила смотрят на флаги. Настройка в админке и правила базы поэтому НЕ МОГУТ
// разойтись: дал роли право — оно появится в токене при следующем входе, и база пустит.
{
  "rules": {
    ".read": false,
    ".write": false,

    // Хэши паролей сотрудников. Читают вошедшие сотрудники (экраны показывают имена
    // авторов и ловят смену пароля). Пишет только тот, у кого есть «Пользователи» или
    // «Права ролей» — иначе любой сотрудник переписал бы список и выдал себе права.
    "titovstroy_users": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": "auth != null && auth.token.usr === true"
    },
    "titovstroy_users_backups": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": "auth != null && auth.token.usr === true"
    },

    // Матрица прав ролей. Читают все вошедшие (по ней приложение считает права),
    // меняет только тот, кому это право выдано. Без этого сотрудник записал бы сюда
    // «всем всё можно» и получил полный доступ.
    "titovstroy_role_permissions": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": "auth != null && auth.token.usr === true"
    },
    "titovstroy_role_permissions_backups": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": "auth != null && auth.token.usr === true"
    },

    // УВЕДОМЛЕНИЯ В TELEGRAM. Три узла, и правила у них разные, потому что цена
    // ошибки разная.
    //
    // tg_settings — общий чат, часы тишины, включение. Меняет тот же, кто ведёт
    // пользователей (флаг usr): по сути это административная настройка.
    //
    // tg_links — кто к какому чату Telegram привязан. ИЗ БРАУЗЕРА НЕ ПИШЕТ НИКТО.
    // Пишет только служба рассылки служебным ключом (он правила обходит). Причина
    // прямая: в уведомления по направлению «Финансы» уходят суммы. Будь запись
    // открыта сотрудникам, любой из них подменил бы чужой chatId на свой и стал
    // бы получать чужую рассылку — молча и не оставив следа в интерфейсе.
    // Читать разрешено: Админка показывает «подключён / не подключён».
    //
    // tg_state — курсор журнала и отметки об отправленном. Служебное, браузеру
    // не нужно ни читать, ни писать.
    // ОФОРМЛЕНИЕ КОМПАНИИ (название, логотип, цвет, WhatsApp, печать).
    // Читают ВСЕ вошедшие, включая анонимных: публичные страницы — КП и кабинет
    // клиента — открываются без учётной записи, а название и логотип на них
    // обязаны быть. Секретного здесь нет: клиент видит и то и другое на своей
    // же странице. Реквизитов тут НЕТ, они в контрагентах и закрыты как раньше.
    // Пишет только тот, кому доверено управление пользователями.
    "titovstroy_brand": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.usr === true"
    },
    "titovstroy_tg_settings": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": "auth != null && auth.token.usr === true"
    },
    "titovstroy_tg_links": {
      ".read": "auth != null && auth.token.staff === true",
      ".write": false
    },
    "titovstroy_tg_state": {
      ".read": false,
      ".write": false
    },

    // Счётчик неудачных попыток входа. Только серверная функция сервисным ключом —
    // он правила обходит. Браузеру здесь делать нечего: узел показывает, какие логины
    // пытались подобрать.
    "titovstroy_login_guard": {
      ".read": false,
      ".write": false
    },

    // Всё остальное — рабочие данные компании.
    //
    // ЧТЕНИЕ: вошедший сотрудник читает рабочие данные, КРОМЕ ДЕНЕГ И ЗАРПЛАТ — они по
    // отдельным флагам (finR, payR). Плюс узлы по секретной ссылке — КП и кабинет клиента,
    // их открывает человек без учётки. Имя узла содержит сам токен из ссылки, перебрать
    // его нельзя, а список ключей база не отдаёт (корень закрыт).
    // Флаги чтения — зеркало условий загрузки в коде (эффекты loadFinance/loadPayroll):
    //   finR ← finance != "none" ИЛИ financialDetails ИЛИ objectFinanceSummary
    //   payR ← payroll != "none" ИЛИ finance != "none"
    // Разойдутся — роль получит пустой раздел вместо данных, поэтому менять их надо ПАРОЙ:
    // здесь и в api/login.js.
    //
    // ЗАПИСЬ: сотрудник пишет всё, кроме трёх защищённых групп, каждая по своему флагу:
    //   деньги   titovstroy_finance_tx*, titovstroy_finance_meta*  → fin
    //   зарплаты titovstroy_staff*, titovstroy_payroll_*           → pay
    //   прайс    titovstroy_catalog*, titovstroy_prices*           → cat
    // Реестр проектов (titovstroy_finance_projects*) НАМЕРЕННО не защищён: он заводится
    // сам при отметке «Договор подписан», это часть обычного хода сделки. Закрой его —
    // и объект зависал бы подписанным без проекта у всех, кроме админа.
    // Общие снимки базы (titovstroy_workspace_backups*) НАМЕРЕННО пишет любой сотрудник:
    // снимок делается автоматически после изменений. Закрыв запись, защиту не усилишь
    // (данные из снимка тот же человек и так правит напрямую), зато снимешь страховку
    // «ничего не теряется» у всех, кроме владельца.
    //
    // ro — РОЛЬ «ТОЛЬКО ЧТЕНИЕ» (наблюдатель). Видит весь сервис, не меняет ничего.
    // В интерфейсе он и так строго read-only, но в токене у него staff:true, а эта ветка
    // пускает на запись любого сотрудника — то есть без флага человек ничего не нажал бы
    // на экране, зато переписал бы данные обычным HTTP-запросом мимо сайта.
    // Исключения — журнал и отметка присутствия: вход наблюдателя должен оставаться
    // в журнале, а heartbeat присутствия не должен зажигать ему аварийный баннер.
    // Флаг ставит сервер входа по роли (api/login.js), матрица прав на него не влияет.
    // data.exists() В ДВУХ ПУБЛИЧНЫХ ВЕТКАХ — ЭТО ЗАПРЕТ СОЗДАВАТЬ УЗЛЫ.
    // Без него посторонний без учётки мог завести в базе любой titovstroy_kp_* или
    // titovstroy_progress_* и лить туда что угодно, раздувая платное хранилище.
    // Проверено на боевой: создание проходило со статусом 200.
    // Публикуют КП и кабинет только сотрудники (ветка staff ниже), а клиент по ссылке
    // лишь ОБНОВЛЯЕТ существующий узел — отмечает просмотр, принимает КП, пишет
    // замечание. Обе публичные страницы сначала читают узел и пишут только внутрь
    // существующего, поэтому запрет на создание им ничего не ломает.
    "$key": {
      ".read": "auth != null && ($key.matches(/^titovstroy_kp_/) || $key.matches(/^titovstroy_progress_/) || (auth.token.staff === true && (!$key.matches(/^titovstroy_finance_(tx|meta)/) || auth.token.finR === true || auth.token.fin === true) && (!$key.matches(/^titovstroy_(staff|payroll_)/) || auth.token.payR === true || auth.token.pay === true)))",
      ".write": "auth != null && (($key.matches(/^titovstroy_kp_/) && data.exists()) || ($key.matches(/^titovstroy_progress_/) && !$key.matches(/_docs$/) && data.exists()) || (auth.token.staff === true && (auth.token.ro !== true || $key.matches(/^titovstroy_(audit|presence)/)) && (!$key.matches(/^titovstroy_finance_(tx|meta)/) || auth.token.fin === true) && (!$key.matches(/^titovstroy_(staff|payroll_)/) || auth.token.pay === true) && (!$key.matches(/^titovstroy_(catalog|prices)/) || auth.token.cat === true)))"
    }
  }
}
