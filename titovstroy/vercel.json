{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notify-cron",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/pdf.mjs": {
      "memory": 1769,
      "maxDuration": 60
    }
  }
}
